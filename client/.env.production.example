# Emergency Assistance - Frontend Production Environment Variables (Template)
# これらの変数はViteビルド時に環境変数として埋め込まれます

# API Base URL (VITE_ プレフィックス必須)
# 注意: /api は含めない（コード側で追加される）
VITE_API_BASE_URL=https://your-backend-api.example.com

# Server URL (VITE_ プレフィックス必須)
# APIベースURLから /api を除いたホスト名
VITE_SERVER_URL=https://your-backend-api.example.com

# Backend Service URL (VITE_ プレフィックス必須)
VITE_BACKEND_SERVICE_URL=https://your-backend-api.example.com
